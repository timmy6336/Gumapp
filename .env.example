# Supabase — get these from your project's Settings → API page
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic — only used server-side in the Supabase Edge Function
# Add this as a Supabase secret (never put it in the app)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Maps — Android map tiles (https://console.cloud.google.com → Maps SDK for Android)
# Without this the map still works but shows an "unauthorized" watermark on Android
GOOGLE_MAPS_API_KEY=

# Sentry — optional crash reporting (https://sentry.io)
EXPO_PUBLIC_SENTRY_DSN=
